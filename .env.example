# Helping Hand Crew — copy to .env and fill in.
# One xAI key is enough for all five Discord bots.

# xAI API (global endpoint — do not use the US regional 1.1x URL)
XAI_API_KEY=xai-your-key-here
XAI_BASE_URL=https://api.x.ai/v1

# Cheapest current general Grok. Never default to grok-4.5 / grok-4.6.
GROK_DEFAULT_MODEL=grok-4.3
# CSE / coding questions only
GROK_CODE_MODEL=grok-build-0.1

# Pause AI replies when estimated Grok spend hits this USD amount in the calendar month.
GROK_MONTHLY_BUDGET_USD=10

# Reply caps (keep these low — this is the main cost control)
GROK_MAX_OUTPUT_TOKENS=350
GROK_CLASSIFY_MAX_TOKENS=20
# grok-4.3 supports reasoning none; keep it off to avoid extra billed tokens
GROK_REASONING_EFFORT=none

# Five Discord bot tokens (free apps from https://discord.com/developers/applications )
DISCORD_TOKEN_CAPTAIN=
DISCORD_TOKEN_TUTOR=
DISCORD_TOKEN_WRITER=
DISCORD_TOKEN_CAMPUS=
DISCORD_TOKEN_FOCUS=

# SQLite file (quotas, KB, budget, memory, reminders)
SQLITE_PATH=data/crew.db

# Daily message quotas
FREE_DAILY_QUOTA=15
PAID_DAILY_QUOTA=80
PAID_ROLE_NAME=Crew Member

# Seed bundled example FAQs if the knowledge base is empty
SEED_SAMPLE_FAQS=1
