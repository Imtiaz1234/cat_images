# Helping Hand Crew — copy to .env and fill in.
# One xAI key is enough for all five bots.

# xAI API (global endpoint — do not use the US regional 1.1x URL)
XAI_API_KEY=xai-your-key-here
XAI_BASE_URL=https://api.x.ai/v1

GROK_DEFAULT_MODEL=grok-4.3
GROK_CODE_MODEL=grok-build-0.1
GROK_MONTHLY_BUDGET_USD=10
GROK_MAX_OUTPUT_TOKENS=180
GROK_CLASSIFY_MAX_TOKENS=20
GROK_REASONING_EFFORT=none

# AgentMail + Gmail-only notifications (python -m helpinghand --mail)
AGENTMAIL_API_KEY=am_...
MAIL_NOTIFY_TO=YOUR_GMAIL@gmail.com
MAIL_ADMINS=YOUR_GMAIL@gmail.com

# Five Discord bot tokens (optional if you only run --mail)
DISCORD_TOKEN_CAPTAIN=
DISCORD_TOKEN_TUTOR=
DISCORD_TOKEN_WRITER=
DISCORD_TOKEN_CAMPUS=
DISCORD_TOKEN_FOCUS=

SQLITE_PATH=data/crew.db
FREE_DAILY_QUOTA=15
PAID_DAILY_QUOTA=80
PAID_ROLE_NAME=Crew Member
SEED_SAMPLE_FAQS=1
